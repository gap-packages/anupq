>            Comm(Comm(b, a), b), b^625 ];
<fp group on the generators [ a, b ]>
gap> procId2 := PqStart( H );
2
gap> StandardPresentation( procId2 : Prime := 5, ClassBound := 15, 
>                           Metabelian );
