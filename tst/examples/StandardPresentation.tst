# interactive form: PqExample( "StandardPresentation", PqStart )
gap> PqQuitAll();
gap> Perform( [ "F", "a", "b", "procId1", "procId2", "procId3", "G", "S", "Spc", "H", "F4", "c", "d", "G4", "K" ],
>      function( v ) if IsBoundGlobal( v ) then UnbindGlobal( v ); fi; end );
